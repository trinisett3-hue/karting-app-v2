# Secrets attendus par les Edge Functions — Supabase > Edge Functions > Secrets.
#
# Ce fichier ne contient AUCUNE valeur sensible et n'est pas lu a l'execution : c'est un
# contrat. Les Edge Functions tournent hors du navigateur, donc elles ne peuvent pas
# deduire l'origine de l'application de window.location.origin comme le fait le reste du
# code (karting-v2/src/config.js). Il faut la leur donner, et rien dans le code ne signale
# qu'elle est fausse — les e-mails partent quand meme, avec un lien mort.
#
# Procedure complete et valeurs de production : docs/DEPLOIEMENT.md
# A tenir a jour a chaque ajout de secret, sous peine de redecouvrir la liste a la main.

# Origine de l'application, SANS slash final. Sert a construire le lien "Voir mes
# resultats" envoye aux pilotes : PUBLIC_APP_URL + '/results?result=' + jeton.
# C'est la seule origine ecrite en dur de tout le systeme.
PUBLIC_APP_URL=https://app.trinisette.fr

# Fournisseur d'envoi : resend | brevo. Defaut : resend.
EMAIL_PROVIDER=resend

# Cle API du fournisseur. Jamais committee, jamais exposee cote navigateur.
EMAIL_API_KEY=

# Expediteur. Le domaine doit etre verifie chez le fournisseur, sinon rejet.
EMAIL_FROM=Trinisette <resultats@trinisette.fr>

# Adresse de reponse. Optionnel mais recommande : sans elle, une reponse d'un pilote
# part vers une adresse d'envoi qui n'est relevee par personne.
EMAIL_REPLY_TO=contact@trinisette.fr

# SUPABASE_URL et SUPABASE_SERVICE_ROLE_KEY sont injectes automatiquement par la
# plateforme. Ne jamais les redefinir ici, et ne JAMAIS exposer la cle service_role
# cote navigateur : elle contourne toutes les policies RLS.
