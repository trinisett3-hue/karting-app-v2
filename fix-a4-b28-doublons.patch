index b61a0f6..1441c97 100644
--- a/karting-v2/src/modules/manual-add.js
+++ b/karting-v2/src/modules/manual-add.js
@@ -161,6 +161,15 @@ async function insertRegistration(row) {
}
const { error } = await db.from('session_registrations').insert(row);
if (error) {

// Filet de securite serveur en plus du controle local already :
// deux admins (ou un admin + le QR public) peuvent ajouter le meme
// pilote au meme instant. La contrainte session_registrations_session_pilot_uidx
// (ajoutee le 30/07, correctif bug A4/B28) l'empeche ; ici on transforme
// juste l'erreur brute en message comprehensible.
if (error.code === '23505' && (error.details || error.message || '').indexOf('session_pilot_uidx') !== -1) {
 maMsg('Ce pilote vient d etre inscrit a cette session (par un autre ecran ou le QR) - pas besoin de le rajouter.', 'err');
 return false;
}
maMsg('Erreur : ' + error.message, 'err');
return false;
}
