// reinscrire une seconde fois se voit repondre avatar deja pris,
// ce qui n'a aucun sens et l'incite a retenter en boucle (bug A4/B28,
// corrige le 30/07 - la contrainte session_registrations_session_pilot_uidx
// n'existait pas avant, donc les doublons passaient silencieusement).
const constraint = (e && (e.details || e.message || '')) + '';
if (e && e.code === '23505' && constraint.indexOf('session_pilot_uidx') !== -1) {
 showMsg('msg-2', 'Tu es deja inscrit a cette session - inutile de t inscrire une seconde fois.', 'err');
} else if (e && e.code === '23505') {
